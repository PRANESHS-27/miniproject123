# ===== Application =====
APP_NAME=VulnWatch
APP_ENV=development
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ===== Bootstrap Admin Credentials =====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vulnwatch.local
ADMIN_PASSWORD=Admin@123
REQUIRE_ADMIN_PASSWORD=false

# ===== Database =====
DATABASE_URL=postgresql+psycopg2://vulnwatch:vulnwatch@postgres:5432/vulnwatch

# ===== CORS =====
# Comma-separated list of allowed origins. Leave empty for dev defaults.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== AI / LLM =====
# Pick one provider. Resolution order: OpenAI → Gemini → Groq → Ollama.
# Groq is the fastest free hosted option: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (Google AI Studio free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (Local LLM)
OLLAMA_HOST=
OLLAMA_MODEL=llama3.1

# ===== Vector Store =====
CHROMA_PERSIST_DIR=./chroma-data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===== CVE Sources =====
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ===== Scheduler =====
ENABLE_SCHEDULER=true
FETCH_INTERVAL_HOURS=24
FETCH_RESULTS_PER_PAGE=2000

# ===== Asset Scanning =====
ASSET_SCAN_INTERVAL_HOURS=24
ASSET_SCAN_TIMEOUT_SECONDS=10.0
ASSET_SCAN_MAX_CONCURRENCY=5

# ===== AWS Production (ECS / S3 / RDS) =====
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=vulnwatch-reports-production
BACKUP_ENABLED=false
BACKUP_UPLOAD_TO_S3=false
