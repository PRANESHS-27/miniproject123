# ===== Application =====
APP_NAME=VulnWatch
APP_ENV=development
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ===== Database =====
DATABASE_URL=postgresql+psycopg2://vulnwatch:vulnwatch@postgres:5432/vulnwatch

# ===== AI / LLM =====
# Pick ONE provider. Resolution order: OpenAI → Gemini → Groq → Ollama.
# Groq is the fastest free hosted option: https://console.groq.com/keys
# Gemini is also free (no card): https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_HOST=
OLLAMA_MODEL=llama3.1

# ===== Vector Store =====
CHROMA_PERSIST_DIR=./chroma-data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===== CVE Sources =====
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ===== Scheduler =====
FETCH_INTERVAL_HOURS=24
FETCH_RESULTS_PER_PAGE=2000

# ===== AWS (optional) =====
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=